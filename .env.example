# ========================================================
# SMART CAMPUS – Environment Configuration Template
# ========================================================

# Express Server Port
PORT=3000

# Google Gemini AI API Key
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini AI Model Selection
# Recommended: gemini-2.5-flash (fast, accurate, high-context)
# Other supported options: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
