# =================================================================
# SMART CAMPUS – Environment Configuration Template
# =================================================================
# For Local Development:
#   Copy this file to `.env` and fill in your GEMINI_API_KEY.
#
# For Vercel Deployment:
#   Go to Vercel Dashboard -> Project -> Settings -> Environment Variables
#   Add `GEMINI_API_KEY` and optionally `GEMINI_MODEL`.
# =================================================================

# Server Port (Local only; Vercel sets this automatically)
PORT=3000

# Google Gemini API Key (Obtain free from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Verified Google Gemini Model Selection:
# - gemini-3.1-flash-lite  (Recommended: ultra-fast, 1-2s latency, high quota)
# - gemini-3.5-flash-lite  (High speed, lightweight)
# - gemini-3.5-flash       (Standard multimodal reasoning)
# - gemini-3.8-flash       (Higher parameter, may encounter 503 during peak spikes)
GEMINI_MODEL=gemini-3.1-flash-lite
